# Réglages de soloist-netwatch (copier dans ~/.config/soloist/netwatch.conf)
# puis : systemctl --user restart soloist-netwatch

# Secondes de réseau stable avant de relancer Soloist
STABLE_DELAY=10
# Secondes minimum entre deux relances
MIN_GAP=30
# Fréquence du test d'internet quand tout va bien (secondes)
PROBE_ONLINE=30
# Relance au plus tard N secondes après un changement de réseau, même si
# le test d'internet échoue
OFFLINE_FORCE=45
# Relance quand Soloist a perdu sa session depuis N secondes
LOGOUT_DELAY=20
